import turtle as t
t.speed(0)
t.bgcolor("black")
colors = ["red","yellow","blue","green","purple","orange","gray","white"]
sides=int(t.numinput("Number of sides",
                     "How many sides do you want (1-8)?",4,1,8))
for x in range(360):
    t.pencolor(colors[x%sides])
    t.circle(x)
    t.lt(360/sides+1)
    t.width(x*sides/200)
t.done()